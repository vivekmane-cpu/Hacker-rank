# Environment Configuration for Kombee Assess

NODE_ENV=development
PORT=4000
WEB_PORT=5173

# Admin / Superuser Database Connection (Used only for migrations and role creation)
DATABASE_SUPERUSER_URL=postgres://macbook@localhost:5432/kombee_assess

# Application Non-Superuser Database Connection (Enforces RLS, rolbypassrls=false)
DATABASE_URL=postgres://kombee_app:kombee_secure_pass@localhost:5432/kombee_assess
DATABASE_APP_USER=kombee_app
DATABASE_APP_PASSWORD=kombee_secure_pass

# Security & Secrets
JWT_SECRET=super-secret-jwt-key-minimum-32-chars-long-kombee-assess
SESSION_COOKIE_SECRET=super-secret-cookie-key-minimum-32-chars-long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Third-Party API Keys (Optional with fallbacks)
ANTHROPIC_API_KEY=
LEAK_SCAN_API_KEY=
